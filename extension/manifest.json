{
  "manifest_version": 3,
  "name": "ResuMorph",
  "description": "Generate a tailored resume from a saved base resume and the active job page.",
  "version": "1.3.0",
  "action": {
    "default_title": "ResuMorph",
    "default_icon": {
      "16": "icons/action-black-16.png",
      "32": "icons/action-black-32.png",
      "48": "icons/action-black-48.png",
      "128": "icons/action-black-128.png"
    }
  },
  "icons": {
    "16": "icons/action-black-16.png",
    "32": "icons/action-black-32.png",
    "48": "icons/action-black-48.png",
    "128": "icons/action-black-128.png"
  },
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/pageAssistant.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
