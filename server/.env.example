DATABASE_URL=sqlite:///./resumorph.db
MASTER_ENCRYPTION_KEY=generate_a_secure_fernet_key_here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_OPENAI_MODEL=
DEFAULT_GEMINI_MODEL=
DEFAULT_CLAUDE_MODEL=
# Recommended local model (speed/quality balance for text generation).
DEFAULT_OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Generation timeout (CPU / cold model load). Keep long.
OLLAMA_TIMEOUT_SECONDS=300
# list_models / test_connection only — fail fast when the host is unreachable.
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
# Context window in tokens. Too small → silent truncation (mid-JSON errors or
# garbage output with no Ollama error). 32768 fits typical resume generation
# (prompt ~5–7k tokens + num_predict up to 4800). Lower only if your model
# cannot load that much context.
OLLAMA_NUM_CTX=32768
ALLOWED_ORIGINS=http://localhost:5173
